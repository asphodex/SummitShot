// Настройки баланса Summit Shot.
// Неверное значение (не число, отрицательное и т.п.) заменяется значением по умолчанию.
{
  // Смена дня и ночи по мере подъёма в гору
  "dayCycle": {
    // Сколько пикселей подъёма нужно, чтобы день полностью сменился ночью (и столько же обратно).
    // Уровень — 1800..4400 px. Больше 0.
    "climbPerPhase": 4000,
    // С какой «темноты» (0 — полдень, 1 — глубокая ночь) начинается закат. Не больше nightFrom.
    "duskFrom": 0.333,
    // С какой «темноты» начинается ночь. От duskFrom до 1.
    "nightFrom": 0.667,
    // Множитель силы врагов в фазе: warm — тёплые, cold — ледяные.
    // 1 — обычная сила, 0.8 — на 20% слабее, 1.2 — на 20% сильнее. Больше 0.
    "phases": {
      "day": { "warm": 1, "cold": 1 },
      "dusk": { "warm": 0.8, "cold": 1.2 },
      "night": { "warm": 0.6, "cold": 1.4 }
    }
  },

  // Сложность врагов и боссов
  "enemies": {
    // На какую долю растёт HP врагов за каждый уровень (0.12 = +12%).
    "hpPerLevel": 0.12,
    // Рост HP не обгоняет эту долю от роста силы атаки героя (0.6 = 60%).
    "hpTracking": 0.6,
    // Прибавка HP врагов за каждый новый сезон (0.3 = +30%).
    "hpPerSeason": 0.3,
    // Базовое HP босса до всех множителей.
    "bossBaseHp": 600,
    // Множитель HP первого босса (уровень 7).
    "bossHpBoostFirst": 3,
    // Множитель HP последнего босса (уровень 35); между первым и последним — плавно.
    "bossHpBoostLast": 5,
    // Дополнительный множитель HP финального босса (Лавовый монстр).
    "finalBossHpMul": 1.6
  },

  // Темп прокачки
  "progression": {
    // В среднем одно усиление на столько уровней (если убивать всех врагов). Больше 0.
    "levelsPerUpgrade": 1.15,
    // С какого уровня доступна 2-я и 3-я стрела очереди. Ровно два числа.
    "burstUnlockLevels": [3, 9],
    // С какого уровня доступен веер стрел.
    "spreadUnlockLevel": 6,
    // С какого уровня доступны стрелы по кругу.
    "ringUnlockLevel": 12
  }
}
